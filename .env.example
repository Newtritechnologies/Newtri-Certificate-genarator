# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side Gmail SMTP (mirrors mailer.php if you prefer SMTP over EmailJS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="NEWTRI Technologies"

# Optional WhatsApp Business Cloud API (mirrors send_whatsapp in mailer.php)
WA_TOKEN=""
WA_PHONE_ID=""
WA_TEMPLATE="certificate_ready"
WA_LANG="en"
